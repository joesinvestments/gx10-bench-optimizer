# Fleet profile: DeepSeek-V4-Flash-0731 TP=4 — the reference profile.
# A model on this fleet IS this file: every instrument reads these keys and nothing else.
FLEET_MODEL_ID=deepseek-v4-flash-0731
FLEET_HOST=192.168.1.16
FLEET_PORT=8000
FLEET_HEAD_CONTAINER=deepseek-v4-0731-vllm-head
FLEET_WORKER_CONTAINER=deepseek-v4-0731-vllm-worker
FLEET_SSH_HEAD=gx10-1
FLEET_NODES="gx10-1 gx10-2 gx10-3 gx10-4"
FLEET_BUNDLE=$HOME/Desktop/DEEPSEEK-V4-RESTORE-BUNDLE
FLEET_LAUNCHER=$FLEET_BUNDLE/scripts/launch_tp4.sh          # must accept a band arg + DRY_RUN in rank script
FLEET_RANK_LAUNCHER=$FLEET_BUNDLE/scripts/launch_rank_tp4.sh
FLEET_BAND=384
# probe shape: this model's PRODUCTION prompt band (measure at the shape you serve)
FLEET_DEEP_TOKENS=150000
FLEET_STORM_CONCURRENCY=12
FLEET_MIXED_CONCURRENCY=11
FLEET_MAX_NUM_SEQS=12
# spec-decode telemetry: which counters carry the drafter EKG (vllm v1 standard names)
FLEET_HEALTHY_ACCEPT_BAND="45-60"
# upstream watch: HF repos (checkpoint/drafter) + GitHub repos (engines/recipes) whose
# movement matters to this model. `fleet <m> upstream` diffs against the last check.
FLEET_UPSTREAM_HF="deepseek-ai/DeepSeek-V4-Flash-0731 deepseek-ai/DeepSeek-V4-Flash-DSpark bleysg/DeepSeek-V4-Flash-DSpark-drafter-GGUF unsloth/DeepSeek-V4-Flash-0731-GGUF"
FLEET_UPSTREAM_GH="Entrpi/ds4 antirez/ds4 tonyd2wild/DeepSeek-v4-Flash-0731-DSpark-1M-NVFP4-KV-2x-DGX-Spark MiaAI-Lab/DeepSeek-v4-Flash-DSpark-2x-DGX-Spark drowzeys/Keys-Concurrency-Patch-for-DSpark-DeepSeek-V4-Flash bertholomus/DeepSeek-V4-Flash-0731-DSpark-Graph8 anemll/dspark-vllm-gx10"
