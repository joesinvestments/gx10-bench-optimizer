# Fleet profile: GLM-5.2 DCP2 (v3 adaptive build, image glm52-dcp:e232d26-adaptive).
# STAGED — GLM is not serving (DeepSeek owns the hardware). Values from the v3 recipe;
# verify against the LIVE container at first boot (the launcher-vs-live drift lesson).
FLEET_MODEL_ID=glm52-dcp2
FLEET_HOST=192.168.1.16
FLEET_PORT=8210   # matches glm_launch.sh API port (was 8100 — profile drift, fixed 2026-08-09)
FLEET_HEAD_CONTAINER=glm52-dcp2-head
FLEET_WORKER_CONTAINER=glm52-dcp2-worker
FLEET_SSH_HEAD=gx10-1
FLEET_NODES="gx10-1 gx10-2 gx10-3 gx10-4"
FLEET_BUNDLE=$HOME/Desktop/GLM52-RESTORE-BUNDLE
FLEET_LAUNCHER=$FLEET_BUNDLE/scripts/glm_launch.sh   # real file; TODO at bring-up: conform to band+DRY_RUN interface
FLEET_RANK_LAUNCHER=
FLEET_BAND=
FLEET_DEEP_TOKENS=100000       # placeholder — profile GLM's REAL band before trusting
FLEET_STORM_CONCURRENCY=12
FLEET_MIXED_CONCURRENCY=11
FLEET_MAX_NUM_SEQS=12
FLEET_HEALTHY_ACCEPT_BAND="unknown-measure-first"
FLEET_UPSTREAM_HF="zai-org/GLM-5.2"
FLEET_UPSTREAM_GH="CosmicRaisins/glm-5.2-gb10"
